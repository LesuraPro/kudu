{
  "name": "familiar-lite",
  "version": "0.1.0",
  "description": "Бесплатная mac-подобная оболочка для Windows: док, виджеты, поиск по Alt+Space",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win zip",
    "package:win:portable": "electron-builder --win portable"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.familiar-lite",
    "productName": "Familiar Lite",
    "files": [
      "main.js",
      "preload.js",
      "bridge.ps1",
      "lib/**/*",
      "src/**/*",
      "examples/**/*",
      "!**/node_modules/@napi-rs/**"
    ],
    "win": {
      "target": "zip"
    },
    "artifactName": "FamiliarLite-${version}-win-${arch}.${ext}"
  },
  "dependencies": {
    "docx": "^9.13.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  }
}
